# Server port
PORT=3001

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# Time (ms) a disconnected player has to reconnect before being removed
RECONNECTION_WINDOW_MS=120000

# Maximum number of concurrent rooms
MAX_ROOMS=50

# Interval (ms) between stale room cleanup runs
ROOM_CLEANUP_INTERVAL_MS=60000

# Time (ms) a room with no connected players is kept before cleanup
STALE_ROOM_TIMEOUT_MS=600000
